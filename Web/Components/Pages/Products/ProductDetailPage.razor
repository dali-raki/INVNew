@page "/products/{productId:guid}"
@using INV.App.Products
@using INV.App.Receipts

@inject IProductService ProductService

<PageHeader Title="Detailed Product Information" />

@if (product != null)
{
    <RadzenCard>
        <h3>@product.Designation</h3>
        <RadzenRow>
            <RadzenColumn Size="6">
                <p>
                    <strong>Quantité :</strong> @product.Quantity
                </p>
               

            </RadzenColumn>
            <RadzenColumn Size="6">
                <p>
                    <strong>Stock :</strong> @product.WareHouse
                </p>
                <p><strong>TVA :</strong> @product.TVA%</p>
                <p>
                    <strong>Unité de mesure :</strong> @product.UnitMeasure
                </p>
            </RadzenColumn>
        </RadzenRow>
            <RadzenRow>
                    <RadzenColumn Size="12">
                <div class="footer-form" style="display:flex;flex-direction: row-reverse;">
                    <button class="btn-custom btn-submit" @onclick="() => ShowProductFormModal(product)">Edit</button>
                        </div>
              
                    </RadzenColumn> 
            </RadzenRow>
    </RadzenCard>

    @if (product.ReceiptInfos != null)
    {
        <RadzenTabs>
            <Tabs>
                <RadzenTabsItem Text="Réceptions">
                    <RadzenDataGrid Data="@product.ReceiptInfos" TItem="ReceiptInfo">
                        <Columns>
                            <RadzenDataGridColumn TItem="ReceiptInfo" Property="Number" Title="Number" />
                            <RadzenDataGridColumn TItem="ReceiptInfo" Property="supplierName" Title="supplierName" />
                            <RadzenDataGridColumn TItem="ReceiptInfo" Property="Date" Title="Date Of Reception" />
                            <RadzenDataGridColumn TItem="ReceiptInfo" Property="DeliveryNumber" Title="Delivery Number" />
                            <RadzenDataGridColumn TItem="ReceiptInfo" Property="DeliveryDate" Title="Delivery Date" />
                            <RadzenDataGridColumn TItem="ReceiptInfo" Property="Status" Title="Status" />
                        </Columns>
                    </RadzenDataGrid>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    }
}
else
{
    <p>Loading...</p>
}
<ProductForm @ref="ProductForm" productEdit="product"  />