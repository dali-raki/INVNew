@page "/productDetail/{productId:guid}"
@using INV.App.Products
@using INV.App.Receipts
@using INV.Implementation.Service.ProductServices

@inject IProductService ProductService

<RadzenCard>
    <Header>
        <h3>@(product?.Designation ?? "Product Detail")</h3>
    </Header>

    @if (product != null)
    {
        <RadzenCard>
            <RadzenRow>
                <RadzenColumn Size="6">
                    <p><strong>Quantité :</strong> @product.Quantity</p>
                    <p><strong>Rest a livree :</strong> @product.Rest</p>
                    <p><strong>Prix unitaire :</strong> @product.UnitPrice.ToString()</p>

                </RadzenColumn>
                <RadzenColumn Size="6">
                    <p><strong>Stock :</strong> @product.WareHouse</p>
                    <p><strong>TVA :</strong> @product.TVA%</p>
                    <p><strong>Unité de mesure :</strong> @product.UnitMeasure</p>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>
        <RadzenTabs>
            <Tabs>
                <RadzenTabsItem Text="Réceptions">
                    <RadzenDataGrid Data="@product.ReceiptInfos" TItem="ReceiptInfo">
                        <Columns>
                            <RadzenDataGridColumn TItem="ReceiptInfo" Property="Number" Title="Numéro" />
                            <RadzenDataGridColumn TItem="ReceiptInfo" Property="Date" Title="Date de réception" />
                            <RadzenDataGridColumn TItem="ReceiptInfo" Property="DeliveryNumber" Title="Delivery Number" />
                            <RadzenDataGridColumn TItem="ReceiptInfo" Property="DeliveryDate" Title="DeliveryDate" />
                            <RadzenDataGridColumn TItem="ReceiptInfo" Property="Status" Title="Statut" />
                        </Columns>
                    </RadzenDataGrid>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    }
    else
    {
        <p>Load Data</p>
    }
</RadzenCard>

@code {
    [Parameter] public Guid ProductId { get; set; }
    private ProductInfo? product;

    protected override async Task OnInitializedAsync()
    {
        product = await ProductService.GetProductById(ProductId);
    }
}