@page "/suppliers/{id:guid}"

@rendermode InteractiveServer



@if (supplier is not null)
{
    
    <PageHeader Title=@supplier.CompanyName  SubTitle=@supplier.Address/>

    <div class="content-profile">
        <div class="container-info-supplier ">
            <SupplierCard Supplier="supplier" />
            <div style="display:flex; justify-content:end" class="m-2">
                <button class="btn-custom btn-submit" type="button" @onclick="editSupplier"><i class="bi bi-pen"></i>Edit</button>
            </div>
           

        </div>

        <div class="container-work-supplier">
            <Tabs EnableFadeEffect="true" NavStyle="NavStyle.Pills">
                <Tab Title="Purchases" IsActive="true">
                    <Content>
                        <PurchaseList purchaseOrderInfos="purchases" ShowSupplier="false" />
                    </Content>
                </Tab>
                @if (receptions != null && receptions.Count > 0)
                {
                    <Tab Title="Reseption">
                        <Content>
                            <ReceptionList Receptions="receptions" />
                        </Content>
                    </Tab>
                }
              
            </Tabs>
        </div>
    </div>
}
<SupplierForm @ref="supplierForm" Update="true" OnSupplierCreated="OnSupplierSaved" />
