@using INV.App.Suppliers
@using INV.Domain.Entities.Suppliers

@if (display)
{
	<Modal Titel="Delete">
		<Pills>
			<div class="title-secondary">
				<h4>Are you sure you want to delete this Supplier?</h4>
			</div>
			<div class="footer-form mt-4">
				<button type="button" class="btn-custom btn-cancel" @onclick="hide">NO</button>
				<button type="button" class="btn-custom btn-submit" @onclick="() => submit(supplierInfo)">YES</button>
			</div>
		</Pills>
	</Modal>
}

