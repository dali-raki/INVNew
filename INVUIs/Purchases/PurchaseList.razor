@using INV.App.Purchases
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="d-flex justify-content-between">
    <input type="text" @bind-value="SearchTerm" placeholder="Search by order number or by supplier name" class="number-input" @bind-value:event="oninput"/>
    <div>
        @Pills
    </div>
</div> 
@if (purchaseOrderInfos is null)
{
    <h3>Loading...</h3>
}
else
{
    <div class="Container-list">
        <RadzenDataGrid Data="@purchaseOrderInfos.OrderByDescending(p => p.Date)" AllowSorting="true" AllowFiltering="true"
                        Style="width: 100%;" RowSelect="@((PurchaseOrderInfo purchaseOrderInfo) => navigatepage(purchaseOrderInfo.Id))"
                        PageSize="8" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true">
            <Columns>

                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.Status)" Title="Status" />
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.Number)" Title="Number" />
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.Date)" Title="Date" />
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.BudgeType)" Title="BudgeType" />
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.ServiceType)" Title="ServiceType" />
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.BudgeArticle)" Title="BudgeArticle" />
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.SupplierName)" Title="Supplier Name" Visible="ShowSupplier"/>
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.TotalTTC)" Title="TotalTTC" />
             
            </Columns>
        </RadzenDataGrid>
    </div>
}
