@using INV.App.Purchases
@using INV.Domain.Entities.Purchases
@using INVUIs.Shared
<div class="container-supplier">
    <div class="content-info-suplier">
        <div class="info-box pos-titel-info-supplier">
            
            <div class="info-boxs-show" style="width:100%">

                <div class="info-box-part1" style="width:100%">
                    @if (purchaseInfo.VisaDate == null && purchaseInfo.VisaNumber == null)
                    {
                        <div style="display:flex;justify-content:end">
                            <button @onclick="Showreject" class="btn-custom btn-delete">Reject</button>
                            <button @onclick="ShowVisa" class="btn-custom btn-submit">Visa</button>

                        </div>
                    }


                    <div class="purchase-container d-f justify-content:center">
                        <div style="text-align:center;width:100%;">
                            <h2>Purchase Details</h2>
                        </div>

                        <div class="purchase-container">
                            <div class="purchase-info">

                                <div class="purchase-info-part1">
                                    <div class="purchase-item">
                                        <strong>Status:</strong> <span>@purchaseInfo.Status</span>
                                    </div>
                                    <div class="purchase-item">
                                        <strong>Number:</strong> <span>@purchaseInfo.Number</span>
                                    </div>
                                    <div class="purchase-item">
                                        <strong>Date:</strong> <span>@purchaseInfo.Date.ToShortDateString()</span>
                                    </div>
                                    <div class="purchase-item">
                                        <strong>Service Type:</strong> <span>@purchaseInfo.ServiceType</span>
                                    </div>
                                    <div class="purchase-item">
                                        <strong>Budget Type:</strong> <span>@purchaseInfo.BudgeType</span>
                                    </div>
                                </div>

                                <div class="purchase-info-part2">
                                    <div class="purchase-item">
                                        <strong>Budget Article:</strong> <span>@purchaseInfo.BudgeArticle</span>
                                    </div>
                                    <div class="purchase-item">
                                        <strong>Completion Delay:</strong> <span>@purchaseInfo.CompletionDelay days</span>
                                    </div>
                                    @*<div class="purchase-item">
                                        <strong>Total (HT):</strong> <span>@purchaseInfo.TotalHT.ToString("DA")</span>
                                    </div>
                                    <div class="purchase-item">
                                        <strong>Total TVA:</strong> <span>@purchaseInfo.TotalTVA.ToString("DA")</span>
                                    </div>
                                    <div class="purchase-item">
                                        <strong>Total (TTC):</strong> <span>@purchaseInfo.TotalTTC.ToString("DA")</span>
                                    </div>*@


                                </div>
                            </div>

                            <div class="purchase-visa ">
                                @if (purchaseInfo.VisaDate != null && purchaseInfo.VisaNumber != null)
                                {
                                    <div class="purchase-item">
                                        <strong>Visa Number:</strong> <span>@purchaseInfo.VisaNumber</span>
                                    </div>
                                    <div class="purchase-item">
                                        <strong>Visa Date:</strong> <span>@purchaseInfo.VisaDate</span>
                                    </div>
                                }
                                <div/>

                            </div>
                        </div>


                    </div>
                </div>


            </div>
        </div>

    </div>
</div>

@if (displayVisa)
{
    <div class="popup">
        <div class="popup-content">
            <input type="date" placeholder="Date Visa" @bind-value="purchaseInfo.VisaDate"/>
            <input type="text" placeholder="Number Visa" @bind-value="purchaseInfo.VisaNumber"/>
            <div class="footer-form">
                <button class="btn-custom btn-cancel" @onclick="HideVisa">Close</button>
                <button class="btn-custom btn-submit" @onclick="() => visa(purchaseInfo)">Save</button>

            </div>
        </div>
    </div>
}

@if (displayReject)
{
    <div class="popup">
        <div class="popup-content">
            <input type="date" placeholder="Date Visa" @bind-value="purchaseInfo.VisaDate"/>
            <input type="text" placeholder="Number Visa" @bind-value="purchaseInfo.VisaNumber"/>
            <input type="text" placeholder="Motif" @bind-value="purchaseInfo.Observation"/>
            <div class="footer-form">
                <button class="btn-custom btn-cancel" @onclick="HideReject">Close</button>
                <button class="btn-custom btn-submit" @onclick="() => reject(purchaseInfo)">Save</button>

            </div>
        </div>
    </div>
}

<style>
  .purchase-container{
      display:flex;
      flex-direction:column;
  }

        .purchase-info{
            display:flex;
        justify-content: flex-start;
     
        }

        .purchase-info-part2{
            margin-left:120px;
        }

        .purchase-info-part1 strong, .purchase-info-part2 strong, .purchase-visa strong {
        color: Var(--primary-color);
    }

 
</style>