@using INV.App.Purchases
@using INV.Domain.Entities.Products
@using INV.Domain.Entities.Purchases
@using INVUIs.Products.ProductsModel
@if (products != null)
{
    <div class="Container-list">
        <RadzenDataGrid Data="@products" AllowSorting="true" AllowFiltering="true"
        Style="width: 100%;">
            <Columns>

                <RadzenDataGridColumn Property="@nameof(ProductModel.Designation)" Title="Designation" />
                <RadzenDataGridColumn Property="@nameof(ProductModel.Quantity)" Title="Quantity" />
                <RadzenDataGridColumn Property="@nameof(ProductModel.UnitPrice)" Title="UnitPrice" />
                <RadzenDataGridColumn Property="@nameof(ProductModel.TVA)" Title="TVA" />
                <RadzenDataGridColumn Property="@nameof(ProductModel.Received)" Title="Received" />
                <RadzenDataGridColumn Property="@nameof(ProductModel.Quantity)" Title="Totale" />
                <RadzenDataGridColumn Property="TotalPrice" Title="Total" Width="18%">
                    <Template Context="product">
                        @((product.UnitPrice * product.Quantity).ToString("N"))
                    </Template>

                </RadzenDataGridColumn>
                  @if (PurchaseStatus == PurchaseStatus.Editing)
                {
                <RadzenDataGridColumn Title="">
                    <Template Context="product">
                        <button class="btn-submit" @onclick="() => EditProduct(product)">Edit </button>
                        <button class="btn-delete" @onclick="DeleteProduct">Delete </button>
                    </Template>
                </RadzenDataGridColumn>
                   }

            </Columns>
        </RadzenDataGrid>
    </div>

    <ProductEditForm product="product" @ref="productEditForm" />
    <ConformationForm @ref="conformationForm" product="product" OnConfirm="OnConfirmDelete" />

}
else
{
    <h1>Loading</h1>
}

@code {
    [Parameter] public List<PurchaseProductInfo> products { get; set; }
    [Inject] public IPurchaseOrderService purchaseOrderService { get; set; }
    private bool display = false;
    private PurchaseProductInfo product = new PurchaseProductInfo();
    private PurchaseProduct editproduct;
    private ProductEditForm productEditForm;
    private ConformationForm conformationForm;
    private PurchaseStatus PurchaseStatus;
    private Guid PurchaseId;
    protected async override void OnAfterRender(bool firstRender)

    {
        if (products != null && products.Count > 0)
        {
            PurchaseId = products.FirstOrDefault().PurchaseId;
            PurchaseStatus = await purchaseOrderService.GetPurchaseStatus(PurchaseId);
            StateHasChanged();
        }
    }

    public async void EditProduct(PurchaseProductInfo product)
    {
        this.product = product;
        productEditForm.show();

   
    }

    public void DeleteProduct()
    {
        conformationForm.show();
    }

    private async Task OnConfirmDelete()
    {
        await purchaseOrderService.RemovePurchaseProduct(new PurchaseProduct
            {
                PurchaseOrderId = product.PurchaseId,
                ProductId = product.ProductId
            });

        // Refresh the product list
        products = await purchaseOrderService.GetProductsByPurchaseId(product.PurchaseId);
        StateHasChanged();
    }
}
