@using INV.App.Receipts
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="d-flex justify-content-between">
    <div>
        @Pills
    </div>
</div>
@if (Receptions is null)
{
    <h3>Loading...</h3>
}
else
{
    <br />
    <br />
    <div class="Container-list">
        <RadzenDataGrid Data="@Receptions" AllowSorting="true" AllowFiltering="true"
                        Style="width: 100%;" RowSelect="@((ReceiptInfo Receptions) => navigatepage(Receptions.Id))">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(ReceiptInfo.Number)" Title="Receipt N°" />
                <RadzenDataGridColumn Property="@nameof(ReceiptInfo.Date)" Title="Receipt Date">
                    <Template Context="reception">
                        @(reception.Date == default ? string.Empty : reception.Date.ToString())
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Title="Purchase">
                    <Template Context="reception">
                        N° @(reception.purchaseNumber) - @(reception.PurchaseDate == default ? string.Empty : reception.PurchaseDate)
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="@nameof(ReceiptInfo.supplierName)" Title="Supplier" />
                <RadzenDataGridColumn Title="Delivery" Sortable="false" Filterable="false">
                    <Template Context="reception">
                        N° @(reception.DeliveryNumber) - @(reception.DeliveryDate == default ? string.Empty : reception.DeliveryDate)
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
}