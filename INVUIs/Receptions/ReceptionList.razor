@using INV.App.Receipts
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="d-flex justify-content-between">
    <div>
        @Pills
    </div>
</div>
@if (Receptions is null)
{
    <h3>Loading...</h3>
}
else
{
    <br />
    <br />
    <div class="Container-list">
        <RadzenDataGrid Data="@Receptions.OrderByDescending(p => p.Date)" AllowSorting="true" AllowFiltering="true"
                        Style="width: 100%;" RowSelect="@((ReceiptInfo Receptions) => navigatepage(Receptions.Id))"
                        PageSize="8" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(ReceiptInfo.Number)" Title="Receipt N°" Width="150px"/>
                <RadzenDataGridColumn Property="@nameof(ReceiptInfo.Date)" Title="Receipt Date" Width="160px">
                    <Template Context="reception">
                        @(reception.Date == default ? string.Empty : reception.Date.ToString())
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Title="Purchase" Visible="ShowPurchase" Width="150px">
                    <Template Context="reception">
                        N° @(reception.purchaseNumber) - @(reception.PurchaseDate == default ? string.Empty : reception.PurchaseDate)
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="@nameof(ReceiptInfo.supplierName)" Title="Supplier" Visible="ShowSupplier"/>
                <RadzenDataGridColumn Title="Delivery" Sortable="false" Filterable="false" Width="260px">
                    <Template Context="reception">
                        N° @(reception.DeliveryNumber) - @(reception.DeliveryDate == default ? string.Empty : reception.DeliveryDate)
                    </Template>
                </RadzenDataGridColumn>


                <RadzenDataGridColumn Property="@nameof(ReceiptInfo.Status)" Title="Status" Width="160px" />

            </Columns>
        </RadzenDataGrid>
    </div>
}